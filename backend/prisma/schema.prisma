generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  name              String
  email             String?  @unique
  password          String?
  current_exp       Int      @default(0)
  available_balance Int      @default(0)
  pending_balance   Int      @default(0)
  total_earned      Int      @default(0)
  role              String   @default("USER")
  bankInfo          String?
  referral_code     String?  @unique
  referred_by       Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productAccesses ProductAccess[]
  affiliateLinks  AffiliateLink[]
  notifications   Notification[]
  walletLedgers   WalletLedger[]
  membership      UserMembership?
}

model Conversion {
  id         String   @id
  user_id    Int
  platform   String?
  title      String?
  price      Int?
  cashback   Int?
  rate       String?
  status     String?
  created_at DateTime @default(now())
}

model SyncMeta {
  key   String @id
  value String
}

model VipLevel {
  level       Int    @id
  title       String
  min_exp     Int
  bonus_rate  Float
  reward_cash Int
}


model Withdrawal {
  id          Int      @id @default(autoincrement())
  user_id     Int
  amount      Int
  bank_info   String?
  status      String   @default("PENDING")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Product {
  id                 Int      @id @default(autoincrement())
  platform           String
  externalProductId  String?
  canonicalUrl       String   @unique
  title              String
  imageUrl           String?
  shopName           String?
  price              Int?
  commissionRate     Float?
  cashbackEstimate   Int?
  currency           String   @default("VND")
  status             String   @default("ACTIVE")
  accessCount        Int      @default(0)
  crawlFailCount     Int      @default(0)
  lastCrawledAt      DateTime?
  lastAccessedAt     DateTime?
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accesses       ProductAccess[]
  affiliateLinks AffiliateLink[]

  @@index([platform, externalProductId])
  @@index([lastAccessedAt])
  @@index([expiresAt])
}

model ProductAccess {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  sourceUrl String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([productId])
}

model AffiliateLink {
  id           Int      @id @default(autoincrement())
  userId       Int
  productId    Int?
  platform     String
  originUrl    String
  affiliateUrl String
  status       String   @default("ACTIVE")
  clickCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([productId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String
  tone      String    @default("pink")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model WalletLedger {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String
  amount      Int
  balanceAfter Int?
  refType     String?
  refId       String?
  description String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([refType, refId])
}

model UserMembership {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tier      String   @default("NORMAL")
  exp       Int      @default(0)
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
